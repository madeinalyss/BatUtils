<Window
  x:Class="BatUtils.Views.ClientWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:properties="clr-namespace:BatUtils.Properties"
  Title="{x:Static properties:Strings.ClientWindowAddTitle}"
  Width="640"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  ShowInTaskbar="False"
  Background="{DynamicResource WindowBackgroundBrush}"
  FocusManager.FocusedElement="{Binding ElementName=CodeTextBox}"
>
  <Window.Resources>
    <Style x:Key="FormLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,8" />
    </Style>
    <Style x:Key="FormTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
      <Setter Property="CaretBrush" Value="{DynamicResource CaretBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
      <Setter Property="Height" Value="24" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="FormCheckBox" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="80" />
      <Setter Property="Height" Value="28" />
    </Style>
  </Window.Resources>
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="90" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />

        <RowDefinition Height="12" />

        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />

        <RowDefinition Height="12" />

        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock
        Grid.Row="0"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowCode}"
        Style="{StaticResource FormLabel}"
      />
      <TextBox
        Grid.Row="0"
        Grid.Column="1"
        Grid.ColumnSpan="5"
        x:Name="CodeTextBox"
        Style="{StaticResource FormTextBox}"
      />
      <TextBlock
        Grid.Row="1"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowName}"
        Style="{StaticResource FormLabel}"
      />
      <TextBox
        Grid.Row="1"
        Grid.Column="1"
        Grid.ColumnSpan="5"
        x:Name="NameTextBox"
        Style="{StaticResource FormTextBox}"
      />
      <TextBlock
        Grid.Row="2"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowEnabled}"
        Style="{StaticResource FormLabel}"
      />
      <CheckBox
        Grid.Row="2"
        Grid.Column="1"
        x:Name="EnabledCheckBox"
        IsChecked="True"
        VerticalAlignment="Center"
        Margin="0,0,0,8"
      />

      <TextBlock
        Grid.Row="4"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowRKAddressPort}"
        Style="{StaticResource FormLabel}"
      />
      <TextBox
        Grid.Row="4"
        Grid.Column="1"
        x:Name="RKAddressTextBox"
        Style="{StaticResource FormTextBox}"
      />
      <TextBlock
        Grid.Row="4"
        Grid.Column="2"
        Text=":"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Margin="0,0,0,8"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
      />
      <TextBox
        Grid.Row="4"
        Grid.Column="3"
        x:Name="RKPortTextBox"
        Style="{StaticResource FormTextBox}"
      />
      <CheckBox
        Grid.Row="4"
        Grid.Column="5"
        x:Name="RKUseHttpsCheckBox"
        Content="{x:Static properties:Strings.ClientWindowUseHttps}"
        Style="{StaticResource FormCheckBox}"
      />
      <TextBlock
        Grid.Row="5"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowRKLoginPassword}"
        Style="{StaticResource FormLabel}"
      />
      <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" x:Name="RKLoginTextBox" Style="{StaticResource FormTextBox}" />
        <TextBlock
          Grid.Column="1"
          Text="/"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="0,0,0,8"
          Foreground="{DynamicResource PrimaryForegroundBrush}"
        />
        <PasswordBox
          Grid.Column="2"
          x:Name="RKPasswordBox"
          Style="{StaticResource FormPasswordBox}"
        />
      </Grid>

      <TextBlock
        Grid.Row="7"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowSHAddressPort}"
        Style="{StaticResource FormLabel}"
      />
      <TextBox
        Grid.Row="7"
        Grid.Column="1"
        x:Name="SHAddressTextBox"
        Style="{StaticResource FormTextBox}"
      />
      <TextBlock
        Grid.Row="7"
        Grid.Column="2"
        Text=":"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Margin="0,0,0,8"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
      />
      <TextBox
        Grid.Row="7"
        Grid.Column="3"
        x:Name="SHPortTextBox"
        Style="{StaticResource FormTextBox}"
      />
      <CheckBox
        Grid.Row="7"
        Grid.Column="5"
        x:Name="SHUseHttpsCheckBox"
        Content="{x:Static properties:Strings.ClientWindowUseHttps}"
        Style="{StaticResource FormCheckBox}"
      />
      <TextBlock
        Grid.Row="8"
        Grid.Column="0"
        Text="{x:Static properties:Strings.ClientWindowSHLoginPassword}"
        Style="{StaticResource FormLabel}"
        Margin="0,0,10,0"
      />
      <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBox
          Grid.Column="0"
          x:Name="SHLoginTextBox"
          Style="{StaticResource FormTextBox}"
          Margin="0"
        />
        <TextBlock
          Grid.Column="1"
          Text="/"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Foreground="{DynamicResource PrimaryForegroundBrush}"
        />
        <PasswordBox
          Grid.Column="2"
          x:Name="SHPasswordBox"
          Style="{StaticResource FormPasswordBox}"
          Margin="0"
        />
      </Grid>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
      <Button
        Content="OK"
        Style="{StaticResource DialogButton}"
        IsDefault="True"
        Margin="0,0,8,0"
        Click="OkButton_Click"
      />
      <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
