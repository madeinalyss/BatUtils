<UserControl x:Class="BatUtils.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:BatUtils.Properties">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="24">

            <!-- Page title -->

            <TextBlock Text="{x:Static properties:Strings.SettingsTitle}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                       Margin="0,0,0,20"/>

            <!-- Appearance -->

            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18"
                    Margin="0,0,0,16">

                <StackPanel>

                    <TextBlock Text="{x:Static properties:Strings.SettingsAppearance}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="{x:Static properties:Strings.SettingsTheme}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>

                        <RadioButton x:Name="SystemThemeRadio"
                                     GroupName="Theme"
                                     Content="{x:Static properties:Strings.SettingsThemeSystem}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"
                                     Checked="ThemeRadio_Checked"/>

                        <RadioButton x:Name="DarkThemeRadio"
                                     GroupName="Theme"
                                     Content="{x:Static properties:Strings.SettingsThemeDark}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"
                                     Checked="ThemeRadio_Checked"/>

                        <RadioButton x:Name="LightThemeRadio"
                                     GroupName="Theme"
                                     Content="{x:Static properties:Strings.SettingsThemeLight}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,16,0"
                                     Checked="ThemeRadio_Checked"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- Language -->

            <Border Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="{x:Static properties:Strings.SettingsLanguage}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{x:Static properties:Strings.SettingsLanguage}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>

                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">

                            <ComboBoxItem Tag="en"
                                          Content="English"/>

                            <ComboBoxItem Tag="ru"
                                          Content="Русский"/>

                        </ComboBox>

                    </Grid>

                    <TextBlock Text="{x:Static properties:Strings.SettingsRestartRequired}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TertiaryForegroundBrush}"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>