<UserControl
  x:Class="BatUtils.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:properties="clr-namespace:BatUtils.Properties"
>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <!-- Title -->

      <TextBlock
        Text="{x:Static properties:Strings.SettingsTitle}"
        FontSize="26"
        FontWeight="SemiBold"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        Margin="0,0,0,20"
      />

      <!-- Root -->

      <Border
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="18"
        Margin="0,0,0,16"
      >
        <StackPanel>
          <TextBlock
            Text="{x:Static properties:Strings.SettingsGeneral}"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryForegroundBrush}"
            Margin="0,0,0,14"
          />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              Text="{x:Static properties:Strings.SettingsRootFolder}"
              VerticalAlignment="Center"
              Foreground="{DynamicResource SecondaryForegroundBrush}"
            />

            <TextBox
              x:Name="RootFolderTextBox"
              Grid.Column="1"
              Margin="0,0,8,0"
              Style="{StaticResource AppTextBox}"
              FontFamily="Consolas"
              TextChanged="RootFolderTextBox_TextChanged"
            />

            <Button
              Grid.Column="2"
              Width="90"
              Height="28"
              Content="{x:Static properties:Strings.Browse}"
              Click="BrowseRootFolder_Click"
            />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Appearance -->

      <Border
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="18"
        Margin="0,0,0,16"
      >
        <StackPanel>
          <TextBlock
            Text="{x:Static properties:Strings.SettingsAppearance}"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryForegroundBrush}"
            Margin="0,0,0,14"
          />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              Text="{x:Static properties:Strings.SettingsTheme}"
              VerticalAlignment="Center"
              Foreground="{DynamicResource SecondaryForegroundBrush}"
            />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <RadioButton
                x:Name="SystemThemeRadio"
                GroupName="Theme"
                Margin="0,0,20,0"
                Content="{x:Static properties:Strings.SettingsThemeSystem}"
                Checked="ThemeRadio_Checked"
              />

              <RadioButton
                x:Name="DarkThemeRadio"
                GroupName="Theme"
                Margin="0,0,20,0"
                Content="{x:Static properties:Strings.SettingsThemeDark}"
                Checked="ThemeRadio_Checked"
              />

              <RadioButton
                x:Name="LightThemeRadio"
                GroupName="Theme"
                Margin="0,0,20,0"
                Content="{x:Static properties:Strings.SettingsThemeLight}"
                Checked="ThemeRadio_Checked"
              />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Language -->

      <Border
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        Padding="18"
      >
        <StackPanel>
          <TextBlock
            Text="{x:Static properties:Strings.SettingsSystem}"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{DynamicResource PrimaryForegroundBrush}"
            Margin="0,0,0,14"
          />

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
              Grid.Column="0"
              Text="{x:Static properties:Strings.SettingsLanguage}"
              VerticalAlignment="Center"
              Foreground="{DynamicResource SecondaryForegroundBrush}"
            />

            <ComboBox
              x:Name="LanguageComboBox"
              Grid.Column="1"
              Width="180"
              HorizontalAlignment="Left"
              SelectionChanged="LanguageComboBox_SelectionChanged"
            >
              <ComboBoxItem Tag="en" Content="English" />

              <ComboBoxItem Tag="ru" Content="Русский" />
            </ComboBox>
          </Grid>

          <TextBlock
            Margin="160,0,0,0"
            Text="{x:Static properties:Strings.SettingsRestartRequired}"
            FontSize="12"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TertiaryForegroundBrush}"
          />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
