<Window
  x:Class="BatUtils.Views.LoginWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:properties="clr-namespace:BatUtils.Properties"
  Title="BAT Utils"
  Width="380"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterScreen"
  ShowInTaskbar="True"
  Background="{DynamicResource WindowBackgroundBrush}"
>
  <Window.Resources>
    <Style x:Key="FormLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="FormPasswordBox" TargetType="PasswordBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,3" />
    </Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Title -->

    <StackPanel Grid.Row="0">
      <TextBlock
        x:Name="TitleText"
        Text="{x:Static properties:Strings.LoginUnlockTitle}"
        FontSize="20"
        FontWeight="SemiBold"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        HorizontalAlignment="Center"
      />

      <TextBlock
        x:Name="DescriptionText"
        Text="{x:Static properties:Strings.LoginUnlockDescription}"
        Margin="0,6,0,0"
        Foreground="{DynamicResource SecondaryForegroundBrush}"
        HorizontalAlignment="Center"
      />
    </StackPanel>

    <!-- Password -->

    <StackPanel Grid.Row="2">
      <TextBlock
        Text="{x:Static properties:Strings.LoginPasswordLabel}"
        Style="{StaticResource FormLabel}"
      />

      <PasswordBox x:Name="PasswordBox" Style="{StaticResource FormPasswordBox}" />
    </StackPanel>

    <!-- Confirm password -->

    <StackPanel x:Name="ConfirmPasswordPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock
        Text="{x:Static properties:Strings.LoginConfirmPasswordLabel}"
        Style="{StaticResource FormLabel}"
      />

      <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource FormPasswordBox}" />
    </StackPanel>

    <!-- Error -->

    <TextBlock
      x:Name="ErrorText"
      Grid.Row="4"
      Margin="0,10,0,0"
      Foreground="IndianRed"
      TextWrapping="Wrap"
      Visibility="Collapsed"
    />

    <!-- Buttons -->

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button
        x:Name="ContinueButton"
        Width="120"
        Height="28"
        Content="{x:Static properties:Strings.LoginUnlockAction}"
        IsDefault="True"
        Click="ContinueButton_Click"
      />

      <Button
        Width="90"
        Height="28"
        Margin="8,0,0,0"
        Content="{x:Static properties:Strings.LoginCancelAction}"
        IsCancel="True"
      />
    </StackPanel>
  </Grid>
</Window>
