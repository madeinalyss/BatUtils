<UserControl
  x:Class="BatUtils.Views.ClientsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:properties="clr-namespace:BatUtils.Properties"
  xmlns:local="clr-namespace:BatUtils.Views"
>
  <UserControl.Resources>
    <local:SoftwareInstalledConverter x:Key="SoftwareInstalledConverter" />
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <!-- Toolbar -->
      <RowDefinition Height="Auto" />

      <!-- Spacing -->
      <RowDefinition Height="10" />

      <!-- Clients -->
      <RowDefinition Height="3*" />

      <!-- Spacing -->
      <RowDefinition Height="8" />

      <!-- Client information -->
      <RowDefinition Height="2*" />
    </Grid.RowDefinitions>

    <!-- ========================================================= -->
    <!-- TOOLBAR -->
    <!-- ========================================================= -->

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left -->
      <StackPanel Orientation="Horizontal">
        <Button
          x:Name="AddButton"
          Style="{StaticResource ToolbarButton}"
          Content="{x:Static properties:Strings.ClientsAdd}"
          Click="AddButton_Click"
        />

        <Button
          x:Name="EditButton"
          Style="{StaticResource ToolbarButton}"
          Content="{x:Static properties:Strings.ClientsEdit}"
          Click="EditButton_Click"
        />

        <Button
          x:Name="DeleteButton"
          Style="{StaticResource ToolbarButton}"
          Content="{x:Static properties:Strings.ClientsDelete}"
          Click="DeleteButton_Click"
        />
      </StackPanel>

      <!-- Center / Search -->
      <TextBox
        x:Name="SearchTextBox"
        Grid.Column="1"
        Style="{StaticResource AppTextBox}"
        Height="28"
        Margin="8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        TextChanged="SearchTextBox_TextChanged"
      />

      <!-- Right -->
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button
          x:Name="CheckButton"
          Style="{StaticResource ToolbarButton}"
          Content="{x:Static properties:Strings.ClientCheck}"
          Click="CheckButton_Click"
        />

        <Button x:Name="MoreButton" Style="{StaticResource ToolbarButton}" Click="MoreButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static properties:Strings.ClientsMore}" />
            <TextBlock Text=" ▾" Margin="3,0,0,0" />
          </StackPanel>

          <Button.ContextMenu>
            <ContextMenu x:Name="MoreContextMenu" Style="{StaticResource AppContextMenu}">
              <MenuItem
                x:Name="RefreshButton"
                Style="{StaticResource AppMenuItem}"
                Header="{x:Static properties:Strings.ClientsRefresh}"
                Click="RefreshButton_Click"
              />

              <Separator Style="{StaticResource AppMenuSeparator}" />

              <MenuItem
                x:Name="ShowInactiveMenuItem"
                Style="{StaticResource AppMenuItem}"
                Header="{x:Static properties:Strings.ClientsShowInactive}"
                IsCheckable="True"
                Click="ShowInactiveMenuItem_Click"
              />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ========================================================= -->
    <!-- CLIENTS TABLE -->
    <!-- ========================================================= -->

    <DataGrid
      x:Name="ClientsGrid"
      Grid.Row="2"
      Background="{DynamicResource WindowBackgroundBrush}"
      Foreground="{DynamicResource PrimaryForegroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1"
      RowHeaderWidth="0"
      AutoGenerateColumns="False"
      IsReadOnly="True"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      GridLinesVisibility="None"
      SelectionMode="Single"
      SelectionUnit="FullRow"
      HorizontalAlignment="Stretch"
      ColumnWidth="*"
      EnableRowVirtualization="True"
      EnableColumnVirtualization="True"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Recycling"
      CanUserSortColumns="True"
      CanUserResizeColumns="True"
      MouseDoubleClick="ClientsGrid_MouseDoubleClick"
    >
      <DataGrid.Columns>
        <!-- ================================================= -->
        <!-- CODE -->
        <!-- ================================================= -->

        <DataGridTextColumn
          Width="*"
          Header="{x:Static properties:Strings.ClientsCode}"
          Binding="{Binding Code}"
          ElementStyle="{StaticResource CenteredCellText}"
        />

        <!-- ================================================= -->
        <!-- NAME -->
        <!-- ================================================= -->

        <DataGridTextColumn
          Width="2*"
          Header="{x:Static properties:Strings.ClientsName}"
          Binding="{Binding Name}"
          ElementStyle="{StaticResource CenteredCellText}"
        />

        <!-- ================================================= -->
        <!-- RK7 -->
        <!-- ================================================= -->

        <DataGridTemplateColumn Width="70" Header="{x:Static properties:Strings.ClientRK7}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock
                Text="{Binding Code,
                                               Converter={StaticResource SoftwareInstalledConverter},
                                               ConverterParameter=RK}"
                Style="{StaticResource CenteredCellText}"
                FontSize="14"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- ================================================= -->
        <!-- SH5 -->
        <!-- ================================================= -->

        <DataGridTemplateColumn Width="70" Header="{x:Static properties:Strings.ClientSH5}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock
                Text="{Binding Code,
                                               Converter={StaticResource SoftwareInstalledConverter},
                                               ConverterParameter=SH}"
                Style="{StaticResource CenteredCellText}"
                FontSize="14"
              />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- ========================================================= -->
    <!-- CLIENT INFORMATION -->
    <!-- ========================================================= -->

    <Border
      Grid.Row="4"
      Background="{DynamicResource PanelBackgroundBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="1"
      Padding="12"
    >
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->

        <TextBlock
          Grid.Row="0"
          Text="{x:Static properties:Strings.ClientInfo}"
          Style="{StaticResource SectionHeader}"
          FontSize="15"
        />

        <!-- Three sections -->

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />

            <ColumnDefinition Width="24" />

            <ColumnDefinition Width="*" />

            <ColumnDefinition Width="24" />

            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- ================================================= -->
          <!-- GENERAL -->
          <!-- ================================================= -->

          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
              Grid.Row="0"
              Text="{x:Static properties:Strings.ClientGeneral}"
              Style="{StaticResource SectionHeader}"
            />

            <Grid Grid.Row="1" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="{x:Static properties:Strings.ClientsCode}"
                Style="{StaticResource InfoLabel}"
              />

              <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding SelectedItem.Code,
                                                      ElementName=ClientsGrid,
                                                      TargetNullValue='—',
                                                      FallbackValue='—'}"
                Style="{StaticResource InfoValue}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="{x:Static properties:Strings.ClientsName}"
                Style="{StaticResource InfoLabel}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding SelectedItem.Name,
                                                      ElementName=ClientsGrid,
                                                      TargetNullValue='—',
                                                      FallbackValue='—'}"
                Style="{StaticResource InfoValue}"
              />
            </Grid>

            <!-- Explore -->

            <Button
              Grid.Row="2"
              Style="{StaticResource ActionButton}"
              Content="{x:Static properties:Strings.ClientExplore}"
              HorizontalAlignment="Left"
              Click="ExploreButton_Click"
            />
          </Grid>

          <!-- Separator -->

          <Border
            Grid.Column="1"
            Width="1"
            Background="{DynamicResource SeparatorBrush}"
            Margin="0,4"
          />

          <!-- ================================================= -->
          <!-- RK7 -->
          <!-- ================================================= -->

          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
              Grid.Row="0"
              Text="{x:Static properties:Strings.ClientRK7}"
              Style="{StaticResource SectionHeader}"
            />

            <Grid Grid.Row="1" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="{x:Static properties:Strings.ClientAddrAndPort}"
                Style="{StaticResource InfoLabel}"
              />

              <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding SelectedItem.RKEndpoint,
                                                      ElementName=ClientsGrid,
                                                      TargetNullValue='—',
                                                      FallbackValue='—'}"
                Style="{StaticResource InfoValue}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="{x:Static properties:Strings.ClientStatus}"
                Style="{StaticResource InfoLabel}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding SelectedItem.RKStatus,
                                                      ElementName=ClientsGrid,
                                                      TargetNullValue='—',
                                                      FallbackValue='—'}"
                ToolTip="{Binding SelectedItem.RKStatusDetails,
                                                         ElementName=ClientsGrid}"
                Style="{StaticResource InfoValue}"
              />
            </Grid>

            <!-- Open RK7 -->

            <Button
              Grid.Row="2"
              Style="{StaticResource ActionButton}"
              Content="{x:Static properties:Strings.ClientOpen}"
              HorizontalAlignment="Left"
              Click="OpenRKButton_Click"
            />
          </Grid>

          <!-- Separator -->

          <Border
            Grid.Column="3"
            Width="1"
            Background="{DynamicResource SeparatorBrush}"
            Margin="0,4"
          />

          <!-- ================================================= -->
          <!-- SH5 -->
          <!-- ================================================= -->

          <Grid Grid.Column="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
              Grid.Row="0"
              Text="{x:Static properties:Strings.ClientSH5}"
              Style="{StaticResource SectionHeader}"
            />

            <Grid Grid.Row="1" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Text="{x:Static properties:Strings.ClientAddrAndPort}"
                Style="{StaticResource InfoLabel}"
              />

              <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding SelectedItem.SHEndpoint,
                                                      ElementName=ClientsGrid,
                                                      TargetNullValue='—',
                                                      FallbackValue='—'}"
                Style="{StaticResource InfoValue}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Text="{x:Static properties:Strings.ClientStatus}"
                Style="{StaticResource InfoLabel}"
              />

              <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                Text="{Binding SelectedItem.SHStatus,
                                                      ElementName=ClientsGrid,
                                                      TargetNullValue='—',
                                                      FallbackValue='—'}"
                ToolTip="{Binding SelectedItem.SHStatusDetails,
                                                         ElementName=ClientsGrid}"
                Style="{StaticResource InfoValue}"
              />
            </Grid>

            <!-- Open SH5 -->

            <Button
              Grid.Row="2"
              Style="{StaticResource ActionButton}"
              Content="{x:Static properties:Strings.ClientOpen}"
              HorizontalAlignment="Left"
              Click="OpenSHButton_Click"
            />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
